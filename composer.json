{
	"name": "ecomailcz/shoptet-client",
	"description": "Basic client for working with Shoptet API",
	"author": "Jan Tlapák (jan@ecomail.cz)",
	"license": ["MIT"],
	"minimum-stability": "dev",
	"prefer-stable": true,
	"require": {
		"php": "^8.1",
		"ext-curl": "*",
		"ext-json": "*"
	},
	"require-dev": {
		"phpunit/phpunit": "^11.5"
	},
	"autoload": {
		"psr-4": {
			"EcomailShoptet\\": ["src/"],
			"EcomailShoptetTest\\": ["tests/"]
		}
	},
	"autoload-dev": {
		"classmap": ["tests/"]
	}
}
